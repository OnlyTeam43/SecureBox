{
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/securebox.apk",
      "destination": "https://github.com/OnlyTeam43/SecureBox/releases/download/V1/SecureBox.apk",
      "permanent": false
    },
    {
      "source": "/SecureBox.apk",
      "destination": "https://github.com/OnlyTeam43/SecureBox/releases/download/V1/SecureBox.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/dropbox",
      "destination": "/dropbox.html"
    },
    {
      "source": "/dropbox/",
      "destination": "/dropbox.html"
    },
    {
      "source": "/drop",
      "destination": "/dropbox.html"
    },
    {
      "source": "/drop/",
      "destination": "/dropbox.html"
    },
    {
      "source": "/quickdrop",
      "destination": "/dropbox.html"
    },
    {
      "source": "/quickdrop/",
      "destination": "/dropbox.html"
    },
    {
      "source": "/Securebox",
      "destination": "/securebox.html"
    },
    {
      "source": "/Securebox/",
      "destination": "/securebox.html"
    },
    {
      "source": "/securebox",
      "destination": "/securebox.html"
    },
    {
      "source": "/securebox/",
      "destination": "/securebox.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
